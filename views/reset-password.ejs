<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <title>Reset Password</title>
    <style>
        * {
            transition: all 0.3s ease;
        }
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }
        .glass {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .input-field:focus {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(96, 165, 250, 0.3);
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .fade-in {
            animation: fadeIn 0.5s ease-out;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-8">
    <div class="max-w-md w-full">
        <div class="text-center mb-8 fade-in">
            <div class="inline-block p-4 bg-white/20 rounded-full mb-4 backdrop-blur-lg">
                <i class="fas fa-lock text-4xl text-white"></i>
            </div>
            <h1 class="text-4xl font-bold text-white mb-2">Reset Password</h1>
            <p class="text-white/80">Enter your new password</p>
        </div>
        
        <div class="glass rounded-2xl p-8 fade-in">
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mb-4 p-4 bg-red-500/20 border-l-4 border-red-500 rounded-lg">
                    <p class="text-red-100 text-sm flex items-center">
                        <i class="fas fa-exclamation-circle mr-2"></i><%= error %>
                    </p>
                </div>
            <% } %>

            <form action="/reset-password" method="post" class="space-y-5">
                <input type="hidden" name="token" value="<%= token %>">
                <div class="relative">
                    <i class="fas fa-key absolute left-4 top-4 text-white/60"></i>
                    <input type="password" name="password" placeholder="New Password" 
                           class="input-field w-full rounded-xl bg-white/10 px-12 py-4 text-white placeholder-white/60 border-2 border-white/20 outline-none focus:border-white/40 backdrop-blur-sm" required>
                </div>
                <button type="submit" class="w-full px-4 py-4 bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white rounded-xl font-semibold text-lg transition shadow-lg">
                    <i class="fas fa-save mr-2"></i>Reset Password
                </button>
            </form>

            <div class="mt-6 text-center">
                <a href="/" class="text-white/80 hover:text-white underline">
                    <i class="fas fa-arrow-left mr-2"></i>Back to Login
                </a>
            </div>
        </div>
    </div>
</body>
</html>
