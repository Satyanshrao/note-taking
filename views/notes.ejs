<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <title>My Notes</title>
    <style>
        * {
            transition: all 0.3s ease;
        }
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }
        .glass {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .note-card {
            transition: all 0.3s;
        }
        .note-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }
        .input-field:focus {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(96, 165, 250, 0.3);
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .fade-in {
            animation: fadeIn 0.5s ease-out;
        }
    </style>
</head>
<body>
    <div class="min-h-screen p-4 md:p-8">
        <div class="max-w-7xl mx-auto">
            <!-- Header -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4 fade-in">
                <div>
                    <h1 class="text-4xl font-bold text-white mb-2">
                        <i class="fas fa-sticky-note mr-3"></i>My Notes
                    </h1>
                    <p class="text-white/80">Organize and manage your thoughts</p>
                </div>
                <div class="flex gap-3">
                    <a href="/dashboard" class="px-5 py-3 glass rounded-xl text-white hover:bg-white/20 transition">
                        <i class="fas fa-home mr-2"></i>Dashboard
                    </a>
                    <a href="/logout" class="px-5 py-3 bg-red-500/80 hover:bg-red-600 text-white rounded-xl transition">
                        <i class="fas fa-sign-out-alt mr-2"></i>Logout
                    </a>
                </div>
            </div>

            <!-- Messages -->
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mb-4 p-4 glass border-l-4 border-red-500 rounded-lg fade-in">
                    <p class="text-red-100 text-sm flex items-center">
                        <i class="fas fa-exclamation-circle mr-2"></i><%= error %>
                    </p>
                </div>
            <% } %>

            <% if (typeof message !== 'undefined' && message) { %>
                <div class="mb-4 p-4 glass border-l-4 border-green-500 rounded-lg fade-in">
                    <p class="text-green-100 text-sm flex items-center">
                        <i class="fas fa-check-circle mr-2"></i><%= message %>
                    </p>
                </div>
            <% } %>

            <!-- Search and Filters -->
            <div class="glass rounded-2xl p-6 mb-6 fade-in">
                <form method="get" action="/notes" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="relative">
                            <i class="fas fa-search absolute left-4 top-4 text-white/60"></i>
                            <input type="text" name="search" value="<%= searchQuery || '' %>" 
                                   placeholder="Search notes..." 
                                   class="input-field w-full rounded-xl bg-white/10 px-12 py-3 text-white placeholder-white/60 border-2 border-white/20 outline-none focus:border-white/40 backdrop-blur-sm">
                        </div>
                        <select name="category" class="w-full rounded-xl bg-white/10 px-4 py-3 text-white border-2 border-white/20 outline-none focus:border-white/40 backdrop-blur-sm">
                            <option value="all" <%= selectedCategory === 'all' ? 'selected' : '' %>>All Categories</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>><%= cat %></option>
                            <% }) %>
                        </select>
                        <select name="priority" class="w-full rounded-xl bg-white/10 px-4 py-3 text-white border-2 border-white/20 outline-none focus:border-white/40 backdrop-blur-sm">
                            <option value="all" <%= selectedPriority === 'all' ? 'selected' : '' %>>All Priorities</option>
                            <option value="high" <%= selectedPriority === 'high' ? 'selected' : '' %>>High</option>
                            <option value="medium" <%= selectedPriority === 'medium' ? 'selected' : '' %>>Medium</option>
                            <option value="low" <%= selectedPriority === 'low' ? 'selected' : '' %>>Low</option>
                        </select>
                        <button type="submit" class="px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-xl font-semibold transition">
                            <i class="fas fa-filter mr-2"></i>Filter
                        </button>
                    </div>
                </form>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Create Note Form -->
                <div class="lg:col-span-1">
                    <div class="glass rounded-2xl p-6 sticky top-4 fade-in">
                        <h2 class="text-2xl text-white font-semibold mb-4" id="form-title">
                            <i class="fas fa-plus-circle mr-2"></i>Create New Note
                        </h2>
                        <form id="note-form" action="/notes/create" method="post" class="space-y-4">
                            <input type="hidden" id="note-id" name="noteId">
                            <input class="input-field w-full rounded-xl bg-white/10 px-4 py-3 text-white placeholder-white/60 border-2 border-white/20 outline-none focus:border-white/40 backdrop-blur-sm" 
                                   type="text" id="note-title" name="title" placeholder="Note Title" required>
                            <textarea class="input-field w-full rounded-xl bg-white/10 px-4 py-3 text-white placeholder-white/60 border-2 border-white/20 outline-none focus:border-white/40 backdrop-blur-sm resize-none" 
                                      id="note-content" name="content" rows="8" placeholder="Write your note here..." required></textarea>
                            <input type="text" name="category" value="general" placeholder="Category" 
                                   class="w-full rounded-xl bg-white/10 px-4 py-3 text-white placeholder-white/60 border-2 border-white/20 outline-none focus:border-white/40 backdrop-blur-sm">
                            <input type="text" name="tags" placeholder="Tags (comma separated)" 
                                   class="w-full rounded-xl bg-white/10 px-4 py-3 text-white placeholder-white/60 border-2 border-white/20 outline-none focus:border-white/40 backdrop-blur-sm">
                            <div class="flex gap-2">
                                <button class="flex-1 px-4 py-3 bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white font-semibold rounded-xl transition shadow-lg" 
                                        type="submit" id="submit-btn">
                                    <i class="fas fa-save mr-2"></i>Create Note
                                </button>
                                <button class="px-4 py-3 glass hover:bg-white/20 text-white rounded-xl transition" 
                                        type="button" id="cancel-btn" onclick="resetForm()" style="display: none;">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Notes List -->
                <div class="lg:col-span-2">
                    <% if (notes && notes.length > 0) { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <% notes.forEach(note => { %>
                                <div class="glass rounded-2xl p-5 note-card fade-in" style="border-left: 4px solid <%= note.color || '#60a5fa' %>;">
                                    <div class="flex justify-between items-start mb-3">
                                        <div class="flex-1">
                                            <% if (note.isPinned) { %>
                                                <i class="fas fa-thumbtack text-yellow-400 mr-2"></i>
                                            <% } %>
                                            <h3 class="text-xl text-white font-semibold inline"><%= note.title %></h3>
                                        </div>
                                        <div class="flex gap-2 ml-2">
                                            <button class="edit-note-btn px-3 py-2 bg-blue-500/80 hover:bg-blue-600 text-white text-sm rounded-lg transition"
                                                    data-id="<%= note._id %>"
                                                    data-title="<%= note.title.replace(/"/g, '&quot;') %>"
                                                    data-content="<%= note.content.replace(/"/g, '&quot;').replace(/\n/g, '\\n') %>"
                                                    data-category="<%= note.category || 'general' %>"
                                                    data-tags="<%= (note.tags || []).join(',') %>">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <form action="/notes/pin/<%= note._id %>" method="post" class="inline">
                                                <button type="submit" class="px-3 py-2 bg-yellow-500/80 hover:bg-yellow-600 text-white text-sm rounded-lg transition" title="Pin/Unpin">
                                                    <i class="fas fa-thumbtack"></i>
                                                </button>
                                            </form>
                                            <form action="/notes/delete/<%= note._id %>" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete this note?')">
                                                <button type="submit" class="px-3 py-2 bg-red-500/80 hover:bg-red-600 text-white text-sm rounded-lg transition">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                    <p class="text-white/80 text-sm mb-3 whitespace-pre-wrap break-words line-clamp-3"><%= note.content %></p>
                                    <div class="flex items-center justify-between text-xs text-white/60">
                                        <span>
                                            <i class="fas fa-calendar mr-1"></i>
                                            <%= new Date(note.updatedAt).toLocaleDateString() %>
                                        </span>
                                        <% if (note.category) { %>
                                            <span class="px-2 py-1 bg-white/10 rounded-lg">
                                                <i class="fas fa-tag mr-1"></i><%= note.category %>
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="glass rounded-2xl p-12 text-center fade-in">
                            <i class="fas fa-sticky-note text-6xl text-white/30 mb-4"></i>
                            <p class="text-white/70 text-lg">No notes found. Create your first note!</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const editButtons = document.querySelectorAll('.edit-note-btn');
            editButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const id = button.getAttribute('data-id');
                    const title = button.getAttribute('data-title');
                    const content = button.getAttribute('data-content').replace(/\\n/g, '\n');
                    const category = button.getAttribute('data-category') || 'general';
                    const tags = button.getAttribute('data-tags') || '';
                    editNote(id, title, content, category, tags);
                });
            });
        });

        function editNote(id, title, content, category, tags) {
            document.getElementById('note-id').value = id;
            document.getElementById('note-title').value = title;
            document.getElementById('note-content').value = content;
            document.querySelector('input[name="category"]').value = category;
            document.querySelector('input[name="tags"]').value = tags;
            document.getElementById('form-title').innerHTML = '<i class="fas fa-edit mr-2"></i>Edit Note';
            document.getElementById('submit-btn').innerHTML = '<i class="fas fa-save mr-2"></i>Update Note';
            document.getElementById('note-form').action = '/notes/edit/' + id;
            document.getElementById('cancel-btn').style.display = 'block';
            document.getElementById('note-form').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function resetForm() {
            document.getElementById('note-id').value = '';
            document.getElementById('note-title').value = '';
            document.getElementById('note-content').value = '';
            document.querySelector('input[name="category"]').value = 'general';
            document.querySelector('input[name="tags"]').value = '';
            document.getElementById('form-title').innerHTML = '<i class="fas fa-plus-circle mr-2"></i>Create New Note';
            document.getElementById('submit-btn').innerHTML = '<i class="fas fa-save mr-2"></i>Create Note';
            document.getElementById('note-form').action = '/notes/create';
            document.getElementById('cancel-btn').style.display = 'none';
        }

        setTimeout(() => {
            document.querySelectorAll('.glass').forEach(msg => {
                if (msg.querySelector('.text-red-100') || msg.querySelector('.text-green-100')) {
                    msg.style.transition = 'opacity 0.5s';
                    msg.style.opacity = '0';
                    setTimeout(() => msg.remove(), 500);
                }
            });
        }, 5000);
    </script>
</body>
</html>
